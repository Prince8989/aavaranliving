{
  "name": "aavaran",
  "version": "0.1.0",
  "private": true,
  "description": "AAVARAN — A House of MATRIKAVA GLOBAL. Premium Indian heritage carpets.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/blob": "2.8.2",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.13.1",
    "razorpay": "2.9.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.49",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "3.2.7"
  }
}
