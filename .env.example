# ─────────────────────────────────────────────────────────────────────────────
# AAVARAN — environment variables
# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Core ───────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aavaran?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=https://aavaranliving.com

# Launch gates (both default to OFF) ─────────────────────────────────────────
# Checkout is refused in production until this is "true" (after policies,
# shipping rates and payment accounts are confirmed).
STORE_CHECKOUT_ENABLED=false
# Live keys (sk_live_, rzp_live_) are rejected unless this is "true".
PAYMENTS_LIVE_MODE=false
# Staging only: show development sample products in a production build.
ALLOW_SAMPLE_PRODUCTS=false

# Stripe — USD / GBP / EUR ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Set "true" only after configuring Stripe Tax registrations.
STRIPE_TAX_ENABLED=false

# Razorpay — INR ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: override which provider settles each currency, e.g. "USD:STRIPE,GBP:STRIPE,EUR:STRIPE,INR:RAZORPAY"
PAYMENT_ROUTING=

# Email (Resend) ─────────────────────────────────────────────────────────────
EMAIL_API_KEY=
# Must be on a domain verified in Resend, e.g. "AAVARAN <orders@aavaranliving.com>"
EMAIL_FROM=
# Receives enquiry notifications
ADMIN_EMAIL=

# Image storage (Vercel Blob) ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# Analytics (loaded only after visitor consent) ──────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Business details shown on the site (leave blank until confirmed) ───────────
NEXT_PUBLIC_SUPPORT_EMAIL=
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PINTEREST_URL=
